{
  "name": "cairn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check:banned-words": "node scripts/check-banned-words.mjs",
    "check:ambient-counts": "node scripts/check-no-ambient-counts.mjs",
    "check:no-network-deps": "bash scripts/check-no-network-deps.sh",
    "check:no-notifications": "bash scripts/check-no-notifications.sh",
    "check:domain-purity": "bash scripts/check-domain-purity.sh",
    "check": "npm run check:banned-words && npm run check:ambient-counts && npm run check:no-network-deps && npm run check:no-notifications && npm run check:domain-purity"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
